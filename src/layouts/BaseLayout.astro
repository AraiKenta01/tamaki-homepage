---
import "../styles/global.css";
import HitCounter from "../components/HitCounter.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;

const navItems = [
  { href: "/", label: "TOP" },
  { href: "/profile/", label: "自己紹介" },
  { href: "/schedule/", label: "スケジュール" },
  { href: "/discography/", label: "ディスコグラフィー" },
  { href: "/bbs/", label: "掲示板" },
  { href: "/breakout/", label: "ブロック崩し" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | 玉置優里ホームページ</title>
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <h1>玉置優里ホームページ</h1>
        <p class="tagline">ミュージシャン・玉置優里 オフィシャルサイト</p>
      </header>

      <nav class="site-nav" aria-label="サイト内ナビゲーション">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <p>リンクフリーです。相互リンク募集中。</p>
        <HitCounter />
        <p>&copy; 玉置優里ホームページ</p>
      </footer>
    </div>
  </body>
</html>
