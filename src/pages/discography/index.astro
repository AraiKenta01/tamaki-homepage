---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const all = (await getCollection("discography")).sort(
  (a, b) => b.data.releaseDate.valueOf() - a.data.releaseDate.valueOf(),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });

const TYPE_LABEL: Record<string, string> = {
  single: "シングル",
  album: "アルバム",
  EP: "EP",
};
---

<BaseLayout title="ディスコグラフィー">
  {
    all.length === 0 ? (
      <div class="box">
        <p>近日公開予定です。</p>
      </div>
    ) : (
      all.map((entry) => (
        <a class="box discography-list-item" href={`/discography/${entry.id}/`}>
          {entry.data.coverImage && (
            <img
              class="discography-thumb"
              src={entry.data.coverImage}
              alt={entry.data.title}
            />
          )}
          <div>
            <p class="discography-list-title">{entry.data.title}</p>
            <p class="discography-list-meta">
              {TYPE_LABEL[entry.data.type]} ／ {formatDate(entry.data.releaseDate)}
            </p>
          </div>
        </a>
      ))
    )
  }
</BaseLayout>
