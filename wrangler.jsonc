{
  "name": "tamaki-homepage",
  "compatibility_date": "2026-09-22",
  "main": "src/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tamaki-homepage-db",
      "database_id": "1b05268d-28c4-42fd-a4d9-056ef2e6c428"
    }
  ],
  // 掲示板の投稿レート制限（Workersネイティブのレート制限バインディング）。
  // namespace_idはこのバインディング固有の識別子で、事前にダッシュボードで
  // 何かを作成する必要はない（デプロイ時に自動的に有効になる）。
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
